# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção). Sem valores aqui.

# Supabase: Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...): só no servidor. Usada para o admin criar contas. Nunca no chat, nunca no código.
SUPABASE_SECRET_KEY=

# Endereço público do sistema, usado no QR Code das etiquetas (ex.: https://manutencao.inovapet.com.br)
NEXT_PUBLIC_SITE_URL=
